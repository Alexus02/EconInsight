{
  "headers": [
    {
      "source": "/(.*\\.(?:js|css|svg|png|jpg|jpeg|webp|gif|ico|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}